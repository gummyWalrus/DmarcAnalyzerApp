{"nodes": [{"id": "docs_planning_adr_0008_deployment_topologies_and_config_contract", "label": "ADR 0008: Deployment Topologies and Config Contract", "file_type": "document", "source_file": "docs/planning/adr/0008-deployment-topologies-and-config-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_adr_0008_deployment_topologies_and_config_contract_app_mode_all", "label": "APP_MODE=all combined runtime mode", "file_type": "rationale", "source_file": "docs/planning/adr/0008-deployment-topologies-and-config-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web host already registers every worker service; worker differs by one AddHostedService line. Unrecognised APP_MODE fails startup since a silent api fallback ingests nothing."}, {"id": "docs_planning_adr_0008_deployment_topologies_and_config_contract_compose_overlays", "label": "Compose overlays (compose.yml, compose.external-db.yml, compose.split.yml) using !reset", "file_type": "rationale", "source_file": "docs/planning/adr/0008-deployment-topologies-and-config-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base file stays a complete quick start because its raw URL is published; profiles rejected because they allow APP_MODE=all plus a worker (two schedulers)."}, {"id": "docs_planning_adr_0008_deployment_topologies_and_config_contract_helm_chart", "label": "Helm chart (postgres.enabled, mode combined|split, pre-upgrade migration Job)", "file_type": "rationale", "source_file": "docs/planning/adr/0008-deployment-topologies-and-config-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal in-chart Postgres StatefulSet instead of Bitnami due to 2025 distribution term changes."}, {"id": "do