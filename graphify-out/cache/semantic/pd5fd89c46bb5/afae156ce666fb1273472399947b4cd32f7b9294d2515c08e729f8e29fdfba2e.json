{"nodes": [{"id": "deploy_helm_dmarc_analyzer_values", "label": "values.yaml", "file_type": "code", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_helm_dmarc_analyzer_values_mode", "label": "Helm deployment mode (combined/split)", "file_type": "concept", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combined is simpler; split gives ingestion and console separate resource limits and independent restarts."}, {"id": "deploy_helm_dmarc_analyzer_values_app_replicas", "label": "app.replicas (pinned to 1 in combined mode)", "file_type": "concept", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each combined replica runs its own ingestion loop, so two replicas means two schedulers claiming the same mailboxes."}, {"id": "deploy_helm_dmarc_analyzer_values_worker_replicas", "label": "worker.replicas (pinned to 1)", "file_type": "concept", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No claim mechanism in the queue; duplicate loops duplicate sync passes, alerts, digests and can move checkpoints backwards."}, {"id": "deploy_helm_dmarc_analyzer_values_postgres", "label": "postgres values (bundled database)", "file_type": "concept", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_helm_dmarc_analyzer_values_externaldatabase", "label": "externalDatabase values", "file_type": "concept", "source_file": "deploy/helm/dmarc-analyzer/values.yaml", "source_loca