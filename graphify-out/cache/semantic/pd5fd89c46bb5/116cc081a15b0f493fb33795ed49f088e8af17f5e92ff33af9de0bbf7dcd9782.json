{"nodes": [{"id": "docs_planning_adr_0009_configuration_export_and_recovery", "label": "ADR 0009: Configuration Export and Recovery", "file_type": "document", "source_file": "docs/planning/adr/0009-configuration-export-and-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_adr_0009_configuration_export_and_recovery_json_configuration_artifact", "label": "JSON configuration artifact as primary backup", "file_type": "rationale", "source_file": "docs/planning/adr/0009-configuration-export-and-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config is what humans typed; SQL dump is opaque, version-tied and restores silently-wrong without ON_ERROR_STOP."}, {"id": "docs_planning_adr_0009_configuration_export_and_recovery_backup_tier_model", "label": "Four backup tiers (config, history, report mail archive, pg_dump)", "file_type": "rationale", "source_file": "docs/planning/adr/0009-configuration-export-and-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_planning_adr_0009_configuration_export_and_recovery_mailbox_is_the_archive", "label": "The mailbox is the archive (report data excluded from backup)", "file_type": "rationale", "source_file": "docs/planning/adr/0009-configuration-export-and-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ingestion is non-destructive and idempotent, so replay inserts only missing reports."}, {"id": "docs_planning_adr_0009_configuration_export_and_recovery_mailbox_retention_deletion", "label": "Opt-in mailbox retention deletion", "file_type": "rationale", "source_file": "docs/planning/adr/0009-configuration-export-and-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null,